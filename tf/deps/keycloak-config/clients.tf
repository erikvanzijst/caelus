# One client per environment.
#
# Both are declared as plain resources rather than one resource parameterized by
# terraform.workspace: tf/deps is the singleton root module and has no
# workspaces. tf/app *selects* which of these to use for its workspace.

resource "keycloak_openid_client" "freepod_prod" {
  realm_id    = keycloak_realm.freepod.id
  client_id   = "freepod-prod"
  name        = "Freepod (production)"
  description = "oauth2-proxy client for ${var.prod_domain}. Managed in tf/deps; consumed by the prod workspace of tf/app."
  enabled     = true

  access_type           = "CONFIDENTIAL"
  standard_flow_enabled = true
  implicit_flow_enabled = false

  # The resource owner password credentials grant trades a username and password
  # straight for tokens. The browser flow never uses it.
  direct_access_grants_enabled = false
  service_accounts_enabled     = false

  pkce_code_challenge_method = "S256"

  valid_redirect_uris = [
    "https://${var.prod_domain}/oauth2/callback",
    "https://${var.prod_domain}",
  ]
  web_origins                     = ["https://${var.prod_domain}"]
  valid_post_logout_redirect_uris = ["https://${var.prod_domain}"]

  frontchannel_logout_enabled = true

  # Secret is generated by Keycloak and surfaced through outputs.tf, to be
  # pasted into tf/app/secrets.auto.tfvars under the "prod" key.
}

resource "keycloak_openid_client" "freepod_dev" {
  realm_id    = keycloak_realm.freepod.id
  client_id   = "freepod-dev"
  name        = "Freepod (development)"
  description = "oauth2-proxy client for ${var.dev_domain}. Access additionally requires membership of the freepod-dev group, enforced at the edge by oauth2-proxy allowed_groups."
  enabled     = true

  access_type           = "CONFIDENTIAL"
  standard_flow_enabled = true
  implicit_flow_enabled = false

  direct_access_grants_enabled = false
  service_accounts_enabled     = false

  pkce_code_challenge_method = "S256"

  valid_redirect_uris = [
    "https://${var.dev_domain}/oauth2/callback",
    "https://${var.dev_domain}",
  ]
  web_origins                     = ["https://${var.dev_domain}"]
  valid_post_logout_redirect_uris = ["https://${var.dev_domain}"]

  frontchannel_logout_enabled = true

  # Secret goes into tf/app/secrets.auto.tfvars under the "default" key — the
  # dev workspace is named `default`, not `dev`.
}

resource "keycloak_openid_client" "grafana" {
  realm_id    = keycloak_realm.freepod.id
  client_id   = "grafana"
  name        = "Grafana"
  description = "Grafana OIDC client. Access requires membership of the freepod-observability group."
  enabled     = true

  access_type           = "CONFIDENTIAL"
  standard_flow_enabled = true
  implicit_flow_enabled = false

  direct_access_grants_enabled = false
  service_accounts_enabled     = false

  # Deliberately no pkce_code_challenge_method. Grafana's generic_oauth only
  # sends a code challenge when `use_pkce = true`, which prometheus/grafana.tf
  # does not set. Requiring S256 here would fail every Grafana login. Turn both
  # on together or neither.

  root_url  = "https://${var.grafana_domain}"
  base_url  = "https://${var.grafana_domain}"
  admin_url = "https://${var.grafana_domain}"

  valid_redirect_uris = ["https://${var.grafana_domain}/login/generic_oauth"]
  web_origins         = ["https://${var.grafana_domain}"]

  frontchannel_logout_enabled = true

  login_theme = "freepod"
}
